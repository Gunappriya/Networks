int totalHammingDistance(int* nums, int numsSize) {
    int total = 0;

    // Check each bit position (0 to 31)
    for (int bit = 0; bit < 32; bit++) {
        int ones = 0;

        // Count numbers having 1 at this bit
        for (int i = 0; i < numsSize; i++) {
            if ((nums[i] >> bit) & 1)
                ones++;
        }

        int zeros = numsSize - ones;

        // Each pair of (1,0) contributes 1 to Hamming distance
        total += ones * zeros;
    }

    return total;
}
